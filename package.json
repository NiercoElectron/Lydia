{
  "name": "lydia",
  "private": true,
  "version": "0.20.0",
  "description": "An open source drawing app",
  "author": "Enrico",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "desktop": "node scripts/desktop.mjs",
    "desktop:build": "npm run build && electron-builder",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:app": "node tests/app/run.mjs",
    "translations": "node scripts/translations.mjs"
  },
  "build": {
    "appId": "io.github.nierco.lydia",
    "productName": "Lydia",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "lyd",
        "name": "Lydia project",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": "universal"
      },
      "category": "public.app-category.graphics-design"
    }
  },
  "dependencies": {
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "lucide-react": "^1.54.0",
    "pixi.js": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "3.9.10",
    "puppeteer-core": "^24.43.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
